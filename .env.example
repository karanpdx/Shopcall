# Server-only. Copy to .env.local; never paste keys into chat.
ELEVENLABS_API_KEY=
# Optional existing agent. Leave empty if Shopcall should provision its own.
ELEVENLABS_AGENT_ID=

# Replit uses OAuth, not an invented API key. Backend credentials will be
# stored separately by the application's OAuth connection flow.
REPLIT_MCP_URL=https://mcp.replit.com/server/mcp

# Fill these after choosing the public backend deployment and email provider.
APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE=
DATABASE_URL=
SESSION_SECRET=
DEMO_OWNER_EMAIL=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# Replit application-owned OAuth. Codex MCP credentials are separate.
DEMO_OWNER_ID=
REPLIT_REDIRECT_URI=http://127.0.0.1:8788/api/replit/callback
# Production: base64-encoded 32-byte encryption key. Local CLI creates an ignored private key.
REPLIT_CREDENTIAL_KEY=
# Adapter module provided by lane B; worker imports createPublicationRuntime().
SHOPCALL_RUNTIME_MODULE=
