# Server-only. Copy to .env.local; never paste keys into chat.
ELEVENLABS_API_KEY=
# Optional existing agent. Leave empty if Shopcall should provision its own.
ELEVENLABS_AGENT_ID=

# Replit uses OAuth, not an invented API key. Backend credentials will be
# stored separately by the application's OAuth connection flow.
REPLIT_MCP_URL=https://mcp.replit.com/server/mcp

# Fill these after choosing the public backend deployment and email provider.
APP_BASE_URL=http://localhost:3000
PUBLIC_API_BASE=
DATABASE_URL=
SESSION_SECRET=
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_BUSINESS_NAME=Your studio
ASSET_STORAGE_DIR=.shopcall/assets
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_API_KEY=

# Replit application-owned OAuth. Codex MCP credentials are separate.
DEMO_OWNER_ID=
REPLIT_REDIRECT_URI=http://127.0.0.1:8788/api/replit/callback
# Production: base64-encoded 32-byte encryption key. Local CLI creates an ignored private key.
REPLIT_CREDENTIAL_KEY=
# Integrated worker requires persistent storage, an observed profile and Chrome.
CHROME_EXECUTABLE_PATH=
REPLIT_RESPONSE_PROFILE_PATH=.shopcall/replit-response-profile.json
# Local fixed-merchant OAuth alias only; not production multi-merchant auth.
REPLIT_CONNECTION_OWNER_ID=

# Optional fixed HTTPS origins for phone/demo frontend API proxy.
SHOPCALL_API_PROXY_ORIGIN=
PHONE_DEMO_ORIGIN=

# Server-only product vision/editing: API key or linked-project OIDC.
AI_GATEWAY_API_KEY=
# Exact provider/model IDs from https://ai-gateway.vercel.sh/v1/models.
SHOPCALL_VISION_MODEL=
SHOPCALL_IMAGE_MODEL=
