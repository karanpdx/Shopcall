{
  "name": "shopcall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/integrations/*.test.ts",
    "agent:setup": "node --env-file=.env.local --import tsx scripts/setup-agent.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts",
    "replit:connect": "node --env-file=.env.local --import tsx scripts/replit-connect.ts",
    "replit:check": "node --env-file=.env.local --import tsx scripts/replit-check.ts",
    "replit:probe": "node --env-file=.env.local --import tsx scripts/replit-probe.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.79.0",
    "@elevenlabs/react": "^1.23.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.2.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
